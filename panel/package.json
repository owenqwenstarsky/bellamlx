{
  "name": "bellamlx",
  "version": "1.6.57",
  "description": "bellaMLX desktop UI for local MLX inference",
  "main": "dist/main/index.mjs",
  "author": "Jinho Jang <eric@jangq.ai>",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "./scripts/bundle-python.sh && ./scripts/verify-bundled-python.sh && electron-vite build",
    "verify-bundled": "./scripts/verify-bundled-python.sh",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "icons": "node generate-icons.js",
    "package": "npm run dist",
    "dist": "npm run build && electron-builder --dir --publish never",
    "postinstall": "electron-builder install-app-deps",
    "build:ui": "electron-vite build",
    "test:electron": "npm run build:ui && node tests/electron/build.mjs && playwright test"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.3.2",
    "katex": "^0.18.1",
    "lucide-react": "^0.577.0",
    "marked": "^12.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^1.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "^3.1.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.17",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^28.2.3",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.60.0",
    "postcss": "^8.5.26",
    "prettier": "^3.2.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "app.bellamlx.desktop",
    "productName": "bellaMLX",
    "copyright": "Copyright 2026 JANGQ AI. All rights reserved.",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "signIgnore": [
        "\\.safetensors$"
      ],
      "minimumSystemVersion": "14.5.0",
      "identity": null
    },
    "dmg": {
      "sign": false,
      "writeUpdateInfo": false,
      "background": "build/dmg-background.png",
      "window": {
        "width": 760,
        "height": 460
      },
      "iconSize": 80,
      "contents": [
        {
          "x": 160,
          "y": 220,
          "name": "bellaMLX.app"
        },
        {
          "x": 600,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "extraResources": [
      {
        "from": "bundled-python",
        "to": "bundled-python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../vmlx_engine",
        "to": "vmlx-engine-source/vmlx_engine",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../pyproject.toml",
        "to": "vmlx-engine-source/pyproject.toml"
      },
      {
        "from": "../README.md",
        "to": "vmlx-engine-source/README.md"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "files": [
      "dist/**/*",
      "out/**/*",
      "resources/**/*",
      "!**/.DS_Store",
      "!dist/test/**"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "release"
    }
  },
  "engines": {
    "node": ">=22 <23"
  }
}
